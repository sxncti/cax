#!/usr/bin/env bash
set -u

# CAX = Codex Account eXchange.
# Sem argumentos, troca a conta padrao. Com 1 a 10, abre uma conta isolada.

codex_command="${CODEX_COMMAND:-codex}"
profiles_root="${CAX_PROFILES_HOME:-$HOME/.codex-accounts}"
shared_state_home="${CAX_SHARED_STATE_HOME:-$HOME/.codex}"
credentials_override='cli_auth_credentials_store="file"'

color_enabled=0
if [[ "${CAX_COLOR:-auto}" == "always" ]] ||
    [[ "${CAX_COLOR:-auto}" == "auto" && -t 1 && -z "${NO_COLOR:-}" ]]; then
    color_enabled=1
fi
color_reset=$'\033[0m'
color_red=$'\033[31m'
color_green=$'\033[32m'
color_yellow=$'\033[33m'

pause_launcher_on_error() {
    if [[ "${CODEX_SWITCH_LAUNCHER:-0}" == "1" && -t 0 ]]; then
        printf '\nPressione Enter para fechar...'
        read -r _
    fi
}

fail() {
    printf 'Erro: %s\n' "$1" >&2
    pause_launcher_on_error
    exit "${2:-1}"
}

usage() {
    cat <<'EOF'
CAX — Codex Account eXchange

Uso:
  cax                         troca a conta padrao do Codex
  cax NUMERO                  abre a conta isolada (1 a 10)
  cax NUMERO login           entra ou troca essa conta
  cax NUMERO logout          sai somente dessa conta
  cax NUMERO status          mostra se a conta esta conectada
  cax NUMERO switch          logout + login somente nessa conta
  cax list                   lista as contas e os limites restantes
  cax bar-data               fornece os limites para a extensao da topbar
  cax auto "TAREFA"          executa com troca automatica de conta
  cax auto resume UUID       continua uma sessao com troca automatica

Exemplo simultaneo, em dois terminais:
  cax 1
  cax 2

Para escolher a conta manualmente pelo codigo do navegador:
  cax 2 login --device-auth
EOF
}

if ! command -v "$codex_command" >/dev/null 2>&1; then
    fail "o comando Codex nao foi encontrado." 127
fi

switch_default() {
    printf 'Trocando a conta padrao do Codex...\n'
    if "$codex_command" login status >/dev/null 2>&1; then
        "$codex_command" logout || fail "nao foi possivel remover a sessao atual."
    fi
    printf '\nAbrindo o navegador para entrar em outra conta...\n'
    "$codex_command" login || fail "o login nao foi concluido. Rode cax para tentar novamente."
    printf '\nPronto: a nova conta esta conectada ao Codex.\n'
}

validate_profile() {
    [[ "$1" =~ ^([1-9]|10)$ ]] ||
        fail "conta invalida. Use um numero de 1 a 10."
}

prepare_profile() {
    profile_home="$profiles_root/$profile"
    umask 077
    mkdir -p "$profile_home" "$shared_state_home" ||
        fail "nao foi possivel preparar os diretorios do perfil $profile."
    chmod 700 "$profiles_root" "$profile_home" "$shared_state_home" 2>/dev/null || true
    if [[ ! -e "$profile_home/config.toml" ]]; then
        printf 'cli_auth_credentials_store = "file"\n' > "$profile_home/config.toml" ||
            fail "nao foi possivel configurar o perfil $profile."
    fi
}

run_profile() {
    CODEX_HOME="$profile_home" CODEX_SQLITE_HOME="$shared_state_home" \
        "$codex_command" -c "$credentials_override" "$@"
}

profile_is_logged_in() {
    run_profile login status >/dev/null 2>&1
}

format_reset_time() {
    local resets_at="$1" now remaining total_minutes days hours minutes
    now="$(date +%s)"
    remaining=$((resets_at - now))
    (( remaining > 0 )) || {
        printf 'agora\n'
        return
    }

    total_minutes=$(((remaining + 59) / 60))
    days=$((total_minutes / 1440))
    hours=$(((total_minutes % 1440) / 60))
    minutes=$((total_minutes % 60))

    if (( days > 0 )); then
        printf '%dd%dh\n' "$days" "$hours"
    elif (( hours > 0 )); then
        printf '%dh%02dm\n' "$hours" "$minutes"
    else
        printf '%dm\n' "$minutes"
    fi
}

paint() {
    local color="$1" text="$2"
    if (( color_enabled )); then
        printf '%s%s%s' "$color" "$text" "$color_reset"
    else
        printf '%s' "$text"
    fi
}

print_usage_field() {
    local percent="$1" reset_time="$2" seconds="$3" window="$4" width="$5"
    local time_color="$color_reset"
    local visible padding meter="["
    local percent_value filled segment

    if [[ "$percent" =~ ^([0-9]+)%$ ]]; then
        percent_value="${BASH_REMATCH[1]}"
        filled=$(((percent_value + 19) / 20))
        (( filled <= 5 )) || filled=5
        for segment in {1..5}; do
            if (( segment <= filled )); then
                meter+="■"
            else
                meter+="□"
            fi
        done
        meter+="]"

        if (( window == 300 )); then
            if (( seconds <= 3600 )); then
                time_color="$color_green"
            elif (( seconds <= 10800 )); then
                time_color="$color_yellow"
            else
                time_color="$color_red"
            fi
        else
            if (( seconds <= 86400 )); then
                time_color="$color_green"
            elif (( seconds <= 259200 )); then
                time_color="$color_yellow"
            else
                time_color="$color_red"
            fi
        fi

        visible="$percent $meter ($reset_time)"
        printf '%s %s ' "$percent" "$meter"
        paint "$time_color" "($reset_time)"
    else
        visible="$percent"
        printf '%s' "$percent"
    fi

    padding=$((width - ${#visible}))
    (( padding > 0 )) && printf '%*s' "$padding" ''
}

profile_usage_limits() {
    local account_home="$1"
    local response="" account_response="" usage_response=""
    local server_pid read_fd write_fd email="--"
    local primary secondary primary_used primary_minutes primary_reset
    local secondary_used secondary_minutes secondary_reset now
    local five_hour="--" five_reset="--" five_seconds=0
    local weekly="--" week_reset="--" week_seconds=0

    coproc CAX_USAGE_SERVER {
        CODEX_HOME="$account_home" CODEX_SQLITE_HOME="$shared_state_home" \
            "$codex_command" -c "$credentials_override" app-server --stdio 2>/dev/null
    }
    server_pid="$CAX_USAGE_SERVER_PID"
    read_fd="${CAX_USAGE_SERVER[0]}"
    write_fd="${CAX_USAGE_SERVER[1]}"

    printf '%s\n' \
        '{"id":1,"method":"initialize","params":{"clientInfo":{"name":"cax","version":"1.3.0"},"capabilities":{"experimentalApi":true}}}' \
        '{"method":"initialized"}' \
        '{"id":2,"method":"account/read","params":{"refreshToken":false}}' \
        '{"id":3,"method":"account/rateLimits/read","params":{"excludeResetCreditDetails":true}}' \
        >&"$write_fd"

    while IFS= read -r -t 8 -u "$read_fd" response; do
        if [[ "$response" == *'"id":2,"result":'* ]]; then
            account_response="$response"
        elif [[ "$response" == *'"id":3,"result":'* ]]; then
            usage_response="$response"
        fi
        [[ -n "$account_response" && -n "$usage_response" ]] && break
    done

    exec {write_fd}>&-
    exec {read_fd}<&-
    kill "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true

    [[ -n "$usage_response" ]] || return 1
    if [[ "$account_response" =~ \"email\":\"([^\"]+)\" ]]; then
        email="${BASH_REMATCH[1]}"
        email="${email%%@*}"
    fi

    primary="${usage_response#*\"primary\":}"
    [[ "$primary" != "$usage_response" ]] || return 1
    primary="${primary%%,\"secondary\":*}"
    secondary="${usage_response#*\"secondary\":}"
    [[ "$secondary" != "$usage_response" ]] || return 1
    secondary="${secondary%%,\"credits\":*}"

    [[ "$primary" =~ \"usedPercent\":([0-9]+) ]] || return 1
    primary_used="${BASH_REMATCH[1]}"
    [[ "$primary" =~ \"windowDurationMins\":([0-9]+) ]] || return 1
    primary_minutes="${BASH_REMATCH[1]}"
    [[ "$primary" =~ \"resetsAt\":([0-9]+) ]] || return 1
    primary_reset="${BASH_REMATCH[1]}"
    [[ "$secondary" =~ \"usedPercent\":([0-9]+) ]] || return 1
    secondary_used="${BASH_REMATCH[1]}"
    [[ "$secondary" =~ \"windowDurationMins\":([0-9]+) ]] || return 1
    secondary_minutes="${BASH_REMATCH[1]}"
    [[ "$secondary" =~ \"resetsAt\":([0-9]+) ]] || return 1
    secondary_reset="${BASH_REMATCH[1]}"

    now="$(date +%s)"

    if (( primary_minutes == 300 )); then
        five_hour="$((100 - primary_used))%"
        five_reset="$(format_reset_time "$primary_reset")"
        five_seconds=$((primary_reset - now))
    elif (( primary_minutes == 10080 )); then
        weekly="$((100 - primary_used))%"
        week_reset="$(format_reset_time "$primary_reset")"
        week_seconds=$((primary_reset - now))
    fi
    if (( secondary_minutes == 300 )); then
        five_hour="$((100 - secondary_used))%"
        five_reset="$(format_reset_time "$secondary_reset")"
        five_seconds=$((secondary_reset - now))
    elif (( secondary_minutes == 10080 )); then
        weekly="$((100 - secondary_used))%"
        week_reset="$(format_reset_time "$secondary_reset")"
        week_seconds=$((secondary_reset - now))
    fi

    (( five_seconds >= 0 )) || five_seconds=0
    (( week_seconds >= 0 )) || week_seconds=0
    printf '%s %s %s %s %s %s %s\n' \
        "$email" "$five_hour" "$five_reset" "$five_seconds" \
        "$weekly" "$week_reset" "$week_seconds"
}

list_profiles() {
    if [[ ! -d "$profiles_root" ]]; then
        printf 'As contas ainda nao foram criadas.\n'
        return
    fi

    local directory name state email five_hour five_reset five_seconds
    local weekly week_reset week_seconds usage_dir email_width=12
    local -a states=() usage_pids=() emails=()
    local -a five_hours=() five_resets=() five_seconds_all=()
    local -a weeklies=() week_resets=() week_seconds_all=()

    umask 077
    usage_dir="$(mktemp -d "${TMPDIR:-/tmp}/cax-usage.XXXXXX")" ||
        fail "nao foi possivel criar o diretorio temporario da consulta."

    # Descobre os logins primeiro e consulta todas as contas conectadas em paralelo.
    for name in {1..10}; do
        directory="$profiles_root/$name"
        [[ -d "$directory" ]] || continue
        profile="$name"
        profile_home="$directory"
        states[$name]="desconectado"
        if profile_is_logged_in; then
            states[$name]="conectado"
            profile_usage_limits "$directory" > "$usage_dir/$name" &
            usage_pids[$name]=$!
        fi
    done

    # Aguarda os processos paralelos e guarda os resultados antes de formatar a tabela.
    for name in {1..10}; do
        [[ -n "${states[$name]:-}" ]] || continue
        state="${states[$name]}"
        email="--"
        five_hour="--"
        five_reset="--"
        five_seconds=0
        weekly="--"
        week_reset="--"
        week_seconds=0
        if [[ "$state" == "conectado" ]]; then
            if wait "${usage_pids[$name]}" &&
                read -r email five_hour five_reset five_seconds weekly week_reset week_seconds \
                    < "$usage_dir/$name"; then
                :
            else
                five_hour="indisp."
                weekly="indisp."
            fi
        fi
        emails[$name]="$email"
        five_hours[$name]="$five_hour"
        five_resets[$name]="$five_reset"
        five_seconds_all[$name]="$five_seconds"
        weeklies[$name]="$weekly"
        week_resets[$name]="$week_reset"
        week_seconds_all[$name]="$week_seconds"
        (( ${#email} > email_width )) && email_width=${#email}
    done

    printf '%-6s %-*s %-12s %-25s %-25s\n' \
        'conta' "$email_width" 'email' 'status' '5h restante' 'semana restante'

    for name in {1..10}; do
        [[ -n "${states[$name]:-}" ]] || continue
        printf '%-6s %-*s %-12s ' \
            "$name" "$email_width" "${emails[$name]}" "${states[$name]}"
        print_usage_field \
            "${five_hours[$name]}" "${five_resets[$name]}" "${five_seconds_all[$name]}" 300 25
        print_usage_field \
            "${weeklies[$name]}" "${week_resets[$name]}" "${week_seconds_all[$name]}" 10080 25
        printf '\n'
    done

    rm -f -- "$usage_dir"/{1..10}
    rmdir -- "$usage_dir"
}

topbar_data() {
    local directory name email five_hour five_reset five_seconds
    local weekly week_reset week_seconds usage_dir five_value weekly_value
    local -a usage_pids=()

    [[ -d "$profiles_root" ]] || return 0
    umask 077
    usage_dir="$(mktemp -d "${TMPDIR:-/tmp}/cax-bar.XXXXXX")" ||
        fail "nao foi possivel criar o diretorio temporario da consulta."

    for name in {1..10}; do
        directory="$profiles_root/$name"
        [[ -d "$directory" ]] || continue
        profile="$name"
        profile_home="$directory"
        if profile_is_logged_in; then
            profile_usage_limits "$directory" > "$usage_dir/$name" &
            usage_pids[$name]=$!
        fi
    done

    for name in {1..10}; do
        [[ -n "${usage_pids[$name]:-}" ]] || continue
        if wait "${usage_pids[$name]}" &&
            read -r email five_hour five_reset five_seconds weekly week_reset week_seconds \
                < "$usage_dir/$name" &&
            [[ "$five_hour" =~ ^([0-9]+)%$ ]]; then
            five_value="${BASH_REMATCH[1]}"
            weekly_value=-1
            if [[ "$weekly" =~ ^([0-9]+)%$ ]]; then
                weekly_value="${BASH_REMATCH[1]}"
            fi
            # Formato estavel: conta, email, 5h restante, reset de 5h e semana restante.
            printf '%s\t%s\t%s\t%s\t%s\n' \
                "$name" "$email" "$five_value" "$five_reset" "$weekly_value"
        fi
    done

    rm -f -- "$usage_dir"/{1..10}
    rmdir -- "$usage_dir"
}

select_auto_profile() {
    local excluded="$1" directory name email five_hour weekly
    local five_value week_value capacity score best_score=-1 best_result=""
    local usage_dir
    local -a usage_pids=()

    [[ -d "$profiles_root" ]] || return 1
    umask 077
    usage_dir="$(mktemp -d "${TMPDIR:-/tmp}/cax-auto-select.XXXXXX")" || return 1

    for name in {1..10}; do
        [[ " $excluded " == *" $name "* ]] && continue
        directory="$profiles_root/$name"
        [[ -d "$directory" ]] || continue
        profile="$name"
        profile_home="$directory"
        if profile_is_logged_in; then
            profile_usage_limits "$directory" > "$usage_dir/$name" &
            usage_pids[$name]=$!
        fi
    done

    for name in {1..10}; do
        [[ -n "${usage_pids[$name]:-}" ]] || continue
        if wait "${usage_pids[$name]}" &&
            read -r email five_hour _ _ weekly _ _ < "$usage_dir/$name"; then
            if [[ "$five_hour" =~ ^([0-9]+)%$ ]]; then
                five_value="${BASH_REMATCH[1]}"
            else
                continue
            fi
            if [[ "$weekly" =~ ^([0-9]+)%$ ]]; then
                week_value="${BASH_REMATCH[1]}"
            else
                continue
            fi
            (( five_value > 0 && week_value > 0 )) || continue
            if (( five_value < week_value )); then
                capacity="$five_value"
            else
                capacity="$week_value"
            fi
            score=$((capacity * 10000 + five_value * 100 + week_value))
            if (( score > best_score )); then
                best_score="$score"
                best_result="$name $email $five_hour $weekly"
            fi
        fi
    done

    rm -f -- "$usage_dir"/{1..10}
    rmdir -- "$usage_dir"
    [[ -n "$best_result" ]] || return 1
    printf '%s\n' "$best_result"
}

auto_limit_error() {
    local output_file="$1"
    grep -Eqi '^ERROR: .*(out of credits|usage limit)' "$output_file"
}

auto_session_id() {
    local output_file="$1" line
    while IFS= read -r line; do
        if [[ "$line" =~ ^session[[:space:]]id:[[:space:]]([0-9a-fA-F-]{36})$ ]]; then
            printf '%s\n' "${BASH_REMATCH[1]}"
            return 0
        fi
    done < "$output_file"
    return 1
}

auto_mode() {
    local session_id="" prompt selection selected email five_hour weekly
    local used_profiles="" output_file status detected_id
    local continuation_prompt='Continue a tarefa exatamente de onde parou. Verifique o estado atual dos arquivos antes de prosseguir.'

    if [[ "${1:-}" == "resume" ]]; then
        shift
        session_id="${1:-}"
        [[ "$session_id" =~ ^[0-9a-fA-F-]{36}$ ]] ||
            fail "informe o UUID da sessao: cax auto resume UUID"
        shift
        if (( $# > 0 )); then
            prompt="$*"
        else
            prompt="$continuation_prompt"
        fi
    else
        (( $# > 0 )) || fail 'informe a tarefa: cax auto "sua tarefa"'
        prompt="$*"
    fi

    while :; do
        if ! selection="$(select_auto_profile "$used_profiles")"; then
            printf 'Nenhuma outra conta conectada possui limite de 5h e semanal disponivel.\n' >&2
            [[ -n "$session_id" ]] && printf 'Sessao preservada: %s\n' "$session_id" >&2
            return 1
        fi
        read -r selected email five_hour weekly <<< "$selection"
        profile="$selected"
        prepare_profile
        printf '\nCAX auto: conta %s (%s), 5h %s, semana %s.\n\n' \
            "$profile" "$email" "$five_hour" "$weekly"

        umask 077
        output_file="$(mktemp "${TMPDIR:-/tmp}/cax-auto-run.XXXXXX")" ||
            fail "nao foi possivel criar o arquivo temporario da execucao."

        if [[ -n "$session_id" ]]; then
            CODEX_HOME="$profile_home" CODEX_SQLITE_HOME="$shared_state_home" \
                "$codex_command" -c "$credentials_override" exec \
                --approve-for-me --skip-git-repo-check \
                resume "$session_id" "$prompt" 2>&1 | tee "$output_file"
        else
            CODEX_HOME="$profile_home" CODEX_SQLITE_HOME="$shared_state_home" \
                "$codex_command" -c "$credentials_override" exec \
                --approve-for-me --skip-git-repo-check \
                "$prompt" 2>&1 | tee "$output_file"
        fi
        status="${PIPESTATUS[0]}"

        if detected_id="$(auto_session_id "$output_file")"; then
            session_id="$detected_id"
        fi

        if (( status != 0 )) && auto_limit_error "$output_file"; then
            rm -f -- "$output_file"
            [[ -n "$session_id" ]] ||
                fail "o limite acabou, mas o UUID da sessao nao foi identificado."
            used_profiles+=" $profile"
            printf '\nCAX auto: limite da conta %s esgotado; procurando outra conta...\n' "$profile"
            prompt="$continuation_prompt"
            continue
        fi

        rm -f -- "$output_file"
        return "$status"
    done
}

if (( $# == 0 )); then
    switch_default
    exit 0
fi

case "$1" in
    -h|--help|help)
        usage
        exit 0
        ;;
    list|ls)
        list_profiles
        exit 0
        ;;
    bar-data)
        topbar_data
        exit 0
        ;;
    auto)
        shift
        auto_mode "$@"
        exit $?
        ;;
esac

profile="$1"
shift
validate_profile "$profile"
prepare_profile

case "${1:-}" in
    login)
        shift
        run_profile login "$@"
        ;;
    logout)
        shift
        run_profile logout "$@"
        ;;
    status)
        shift
        run_profile login status "$@"
        ;;
    switch)
        shift
        profile_is_logged_in && run_profile logout
        run_profile login "$@"
        ;;
    *)
        if ! profile_is_logged_in; then
            printf 'Primeiro acesso ao perfil "%s". Abrindo o login no navegador...\n\n' "$profile"
            run_profile login || fail "o login do perfil $profile nao foi concluido."
        fi
        exec env CODEX_HOME="$profile_home" CODEX_SQLITE_HOME="$shared_state_home" \
            "$codex_command" -c "$credentials_override" "$@"
        ;;
esac
